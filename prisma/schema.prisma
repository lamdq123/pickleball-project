datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  phone     String?
  password  String    @default("123456")
  createdAt DateTime  @default(now())
  bookings  Booking[] // Thêm dòng này: 1 User có thể có nhiều Booking
  reviews   Review[]
}

model Court {
  id           Int       @id @default(autoincrement())
  name         String
  location     String
  pricePerHour Float
  createdAt    DateTime  @default(now())
  bookings     Booking[] // Thêm dòng này: 1 Sân có thể có nhiều Booking
  reviews   Review[]
}

// BẢNG MỚI: Lưu trữ thông tin Đặt Sân
model Booking {
  id        Int      @id @default(autoincrement())
  userId    Int      // ID của người đặt
  courtId   Int      // ID của sân được đặt
  bookDate  String   // Ngày chơi (Ví dụ: "2026-07-10")
  timeSlot  String   // Khung giờ (Ví dụ: "17:00 - 18:00")
  createdAt DateTime @default(now())

  // Khai báo mối quan hệ để Prisma hiểu
  user      User     @relation(fields: [userId], references: [id])
  court     Court    @relation(fields: [courtId], references: [id])
}
// BẢNG MÃ GIẢM GIÁ
model PromoCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique                 // Mã text (VD: GIAM20K)
  discount    Int                              // Số tiền giảm hoặc phần trăm
  isPercent   Boolean  @default(false)         // Nếu true thì giảm theo %, false thì giảm thẳng tiền mặt
  isActive    Boolean  @default(true)          // Trạng thái (Còn hạn hay không)
  createdAt   DateTime @default(now())
}

// BẢNG ĐÁNH GIÁ (RATING)
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      // Số sao (Từ 1 đến 5)
  comment   String?  // Lời bình luận (Có thể để trống)
  courtId   Int      // Đánh giá cho Sân nào
  userId    Int      // Ai là người đánh giá
  createdAt DateTime @default(now())

  // Mối quan hệ (Relations)
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}