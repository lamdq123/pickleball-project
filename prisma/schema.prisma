datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      String   @default("customer") // 👉 Thêm dòng này: "admin" hoặc "customer"
  bookings  Booking[]
  reviews   Review[]
  createdAt DateTime @default(now())
}

model Court {
  id              Int       @id @default(autoincrement())
  name            String
  location        String
  pricePerHour    Float
  imageUrl        String?
  // 👉 THÊM 3 DÒNG NÀY ĐỂ LƯU GIỜ VÀNG
  goldenHourStart String?   // Ví dụ: "16:00"
  goldenHourEnd   String?   // Ví dụ: "19:00"
  goldenDiscount  Int?      @default(0) // Ví dụ: 10 (%)

  bookings        Booking[]
  reviews         Review[]
  createdAt       DateTime  @default(now())
}

// BẢNG MỚI: Lưu trữ thông tin Đặt Sân
model Booking {
  id        Int      @id @default(autoincrement())
  userId    Int      // ID của người đặt
  courtId   Int      // ID của sân được đặt
  bookDate  String   // Ngày chơi (Ví dụ: "2026-07-10")
  timeSlot  String   // Khung giờ (Ví dụ: "17:00 - 18:00")
  createdAt DateTime @default(now())

  // Khai báo mối quan hệ để Prisma hiểu
  user      User     @relation(fields: [userId], references: [id])
  court     Court    @relation(fields: [courtId], references: [id])
}
// BẢNG MÃ GIẢM GIÁ
model Promo {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  discount    Int
  
  // 👉 3 Trường mới thêm vào:
  description String? // Lời quảng cáo (VD: Siêu sale 8/8)
  validFrom   String? // Ngày bắt đầu (YYYY-MM-DD)
  validTo     String? // Ngày kết thúc (YYYY-MM-DD)
}

// BẢNG ĐÁNH GIÁ (RATING)
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      // Số sao (Từ 1 đến 5)
  comment   String?  // Lời bình luận (Có thể để trống)
  courtId   Int      // Đánh giá cho Sân nào
  userId    Int      // Ai là người đánh giá
  createdAt DateTime @default(now())

  // Mối quan hệ (Relations)
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}